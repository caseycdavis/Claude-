{
  "name": "parce",
  "version": "0.1.0",
  "private": true,
  "description": "A private bilingual messenger on top of one WhatsApp chat",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "demo": "PARCE_DEMO=1 node --disable-warning=ExperimentalWarning dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "smoke:translate": "node --disable-warning=ExperimentalWarning dist/server/scripts/smoke-translate.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.12",
    "baileys": "7.0.0-rc14",
    "fastify": "^5.12.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
